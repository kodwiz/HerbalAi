  "child_policy": {
    "infant_max_months": 12,
    "toddler_max_years": 2,
    "child_max_years": 11,
    "teen_max_years": 17,
    "notes": {
      "under_1": "No herbs, no honey (infant botulism). See a paediatrician or pharmacist.",
      "1_to_2": "Only honey for cough (1 to 2 years: half a teaspoon) and normal food. See a paediatrician for anything else.",
      "3_to_11": "Gentle kitchen herbs in food or weak, cooled teas only (chamomile, fennel, ginger in food, honey for cough). Avoid essential oils near the face, strong teas, licorice, ashwagandha, valerian and anything concentrated. Check amounts with a paediatric pharmacist.",
      "12_to_17": "Low-risk herbs at roughly half to adult amounts. Avoid higher-risk herbs (ashwagandha, licorice, valerian, sage, vitex, black cohosh, willow bark, St John's wort)."
    }
  }

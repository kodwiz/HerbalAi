{
  "_note": "Graduated safety rules for the herbalist consultation engine. Medication keyword lists are used to CLASSIFY what a patient takes so that herb-specific interactions can be applied precisely. They are not a complete drug database. A medicine that is not recognised is handled by herb risk level (see herbalist_screening.py), never by a blanket refusal.",
  "never_recommend": [
    {
      "name": "kava",
      "aliases": [
        "kava kava",
        "piper methysticum"
      ],
      "why": "serious liver injury reports"
    },
    {
      "name": "comfrey (internal)",
      "aliases": [
        "comfrey tea",
        "symphytum"
      ],
      "why": "pyrrolizidine alkaloids, liver damage when taken by mouth"
    },
    {
      "name": "ephedra",
      "aliases": [
        "ma huang",
        "ephedra sinica"
      ],
      "why": "heart attack, stroke and death reports"
    },
    {
      "name": "aristolochia",
      "aliases": [
        "aristolochic acid",
        "birthwort"
      ],
      "why": "kidney failure and urinary tract cancer"
    },
    {
      "name": "chaparral",
      "aliases": [
        "larrea tridentata"
      ],
      "why": "liver failure"
    },
    {
      "name": "pennyroyal",

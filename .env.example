# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Get an API key from the Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1200

# Herbalist mode (default on): 1 = AI herbalist gives herbal plans straight away, graded safety screening.
# 0 = original strict intake-first flow.
HERBALIST_MODE=1
AI_HERBALIST_MAX_TOKENS=1800
AI_HERBALIST_TIMEOUT_SECONDS=60
